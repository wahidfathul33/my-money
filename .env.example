# Copy to .env and fill in real values. Never commit .env.
# See docs/11-tech-architecture.md §8 and docs/13-deployment-vercel.md §3.

# Neon PostgreSQL — pooled connection string, used at runtime
DATABASE_URL=

# Neon PostgreSQL — direct (unpooled) connection string, used for migrations
DATABASE_URL_UNPOOLED=

# Auth.js — random secret, min 32 chars (`openssl rand -base64 32`)
AUTH_SECRET=

# Auth.js — canonical app URL; optional locally/on Vercel (inferred), set explicitly elsewhere
AUTH_URL=

# Google OAuth client ID (Google Cloud Console)
GOOGLE_CLIENT_ID=

# Google OAuth client secret
GOOGLE_CLIENT_SECRET=

# Shared secret required by Vercel Cron routes, min 32 chars
CRON_SECRET=

# SMTP — used by the Auth.js magic-link (Email) provider, task 04
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=

# Resend API key — reserved for household invitation email (task 10); not used by auth
RESEND_API_KEY=

# Verified sender address (SPF + DKIM) for outgoing email — magic link & invitations
EMAIL_FROM=

# Base URL used to build invitation links
APP_URL=

# Gold price source: "manual" or "external"
GOLD_PRICE_PROVIDER=

# External gold price API URL (only if GOLD_PRICE_PROVIDER=external)
GOLD_PRICE_API_URL=

# External gold price API key (only if GOLD_PRICE_PROVIDER=external)
GOLD_PRICE_API_KEY=

# Sentry — task 23, docs/13-deployment-vercel.md §9. Optional: unset means
# Sentry.init() runs as a documented no-op (src/lib/observability/sentry.ts).
# DSN is a public identifier, not a secret — safe as NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry — build-time only, source map upload. Never sent to the client.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
